"preset.box_breathing.desc" = "Gleichmäßige Einatem-, Halte-, Ausatem- und Haltephasen von je 4 Sekunden. Beruhigt das Nervensystem und stärkt die Atemkontrolle.";

/* No comment provided by engineer. */
"preset.478.desc" = "4 Sekunden einatmen, 7 halten, 8 ausatmen. Dr. Andrew Weils Technik zur Angstreduktion und Schlafförderung.";

/* No comment provided by engineer. */
"preset.silent_anchor.desc" = "Ein einstündiger stiller Anker, der nur durch sanfte Taschenvibrationen geführt wird. Alle 4 Sekunden signalisiert ein sanfter Puls deinen Atem – einatmen, dann ausatmen. Nutze ihn beim Zahnarzt, vor einer Präsentation, in schwierigen Gesprächen, im Flugzeug oder in Menschenmassen. Kein Ton, kein Bildschirm. Nur ein ruhiger Rhythmus in deiner Tasche.";

/* No comment provided by engineer. */
"preset.coherent.desc" = "Kohärente Atmung ist ein gleichmäßiges Atemprogramm, das dich in einen ausgewogenen Ein- und Ausatemrhythmus führt, um ruhige Konzentration und Nervensystemregulation zu unterstützen.";

/* No comment provided by engineer. */
"preset.presleep.desc" = "Schlaf-Atmung ist ein sanftes Atemprogramm, das die Atmung in einen ruhigen Rhythmus verlangsamt, um dem Körper beim Einschlafen zu helfen.";

/* No comment provided by engineer. */
"preset.med10.desc" = "10-Minuten-Meditation läutet alle zwei Minuten eine sanfte Glocke, um dir zu helfen, ohne Unterbrechung der Praxis ins Bewusstsein zurückzukehren.";

/* No comment provided by engineer. */
"preset.med15.desc" = "15-Minuten-Meditation läutet alle drei Minuten eine sanfte Glocke, um dir zu helfen, ohne Unterbrechung der Praxis ins Bewusstsein zurückzukehren.";

/* No comment provided by engineer. */
"preset.med20.desc" = "20-Minuten-Meditation läutet alle 5 Minuten eine sanfte Glocke, um dir zu helfen, ohne Unterbrechung der Praxis ins Bewusstsein zurückzukehren.";

/* No comment provided by engineer. */
"preset.med30.desc" = "30-Minuten-Meditation läutet alle 5 Minuten eine sanfte Glocke, um dir zu helfen, ohne Unterbrechung der Praxis ins Bewusstsein zurückzukehren.";

/* No comment provided by engineer. */
"preset.tabata.desc" = "20 Sekunden maximale Anstrengung, 10 Sekunden Ruhe, 8-mal wiederholt. Ein Hochintensitätsprotokoll, das nachweislich die aerobe und anaerobe Kapazität steigert.";

/* No comment provided by engineer. */
"preset.hiit.desc" = "HIIT Classic ist ein hochintensives Intervallprogramm, das kurze Phasen intensiver Anstrengung mit kurzen Erholungsphasen abwechselt.";

